# Copy to /etc/saad-node-agent/agent.env and replace the token.
NODE_ID=econrg-lab
NODE_NAME=econrg-lab

DASHBOARD_URL=https://app.salesrbas.tech
NODE_TOKEN=replace-with-node-token

HEARTBEAT_INTERVAL_SECONDS=15

# WebSocket v2 sends telemetry continuously. HTTP heartbeat remains a fallback
# reconciliation path only when the WebSocket has been unavailable.
TELEMETRY_INTERVAL_SECONDS=2
FULL_SNAPSHOT_INTERVAL_SECONDS=30
WS_PING_INTERVAL_SECONDS=15
WS_PING_TIMEOUT_SECONDS=15
WS_RECONNECT_INITIAL_SECONDS=1
WS_RECONNECT_MAX_SECONDS=30

SAAD_DEPLOY_PATH=/opt/saad-deploy
SAAD_DEPLOY_CONFIG_DIR=/etc/saad-deploy

# The process only receives Docker data through this fixed helper via sudo.
SNAPSHOT_HELPER_PATH=/usr/local/lib/saad-node-agent/snapshot.sh
SNAPSHOT_USE_SUDO=true

# Root-only saad-deploy env files are read through this helper. It returns only
# permitted CRM metadata and deployment status; it never returns env secrets.
DEPLOY_METADATA_HELPER_PATH=/usr/local/lib/saad-node-agent/deploy-metadata.py
DEPLOY_METADATA_USE_SUDO=true
