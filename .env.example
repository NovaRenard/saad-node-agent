# Copy to /etc/saad-node-agent/agent.env and replace the token.
NODE_ID=econrg-lab
NODE_NAME=econrg-lab

DASHBOARD_URL=https://app.salesrbas.tech
NODE_TOKEN=replace-with-node-token

HEARTBEAT_INTERVAL_SECONDS=15

SAAD_DEPLOY_PATH=/opt/saad-deploy
SAAD_DEPLOY_CONFIG_DIR=/etc/saad-deploy

# The process only receives Docker data through this fixed helper via sudo.
SNAPSHOT_HELPER_PATH=/usr/local/lib/saad-node-agent/snapshot.sh
SNAPSHOT_USE_SUDO=true
